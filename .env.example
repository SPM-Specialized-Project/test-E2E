# Set REMOTE_HOST to change both app and API targets together.
REMOTE_HOST=
# Set these only when the frontend and API use different origins.
BASE_URL=
API_BASE_URL=
# Remote write tests create/update test data and require explicit opt-in.
ALLOW_REMOTE_WRITES=false
# US-006 is temporarily excluded from the default suite.
RUN_US006=false
# Path to the staging backend checkout used by the isolated password-log test.
SPM_E2E_BACKEND_ROOT=
